# BlueDotAtlas development template. No live credentials or secrets in Git.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Runtime database URL is server-side only; use an isolated local PostgreSQL DB.
# Example syntax (never put a real URL in Git): postgresql://USER:PASSWORD@localhost:5432/DB
# Auth and storage remain future M02 tasks.
DATABASE_URL=
SESSION_SECRET=
BDA_STORAGE_ROOT=./.local-data

# Roadmap 025 (runtime-only): single administrator. NEVER commit real values.
# BDA_ADMIN_EMAIL=admin@example.invalid
# BDA_ADMIN_PASSWORD_HASH=scrypt$... (generated safely; see docs/development/admin-auth.md)
# Database access still requires DATABASE_URL, set server-side only.
# Production login requires HTTPS and __Host-bda-session Secure cookie.
