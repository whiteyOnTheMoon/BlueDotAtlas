{
  "name": "bluedotatlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json tsconfig.base.json pnpm-workspace.yaml eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json tsconfig.base.json pnpm-workspace.yaml eslint.config.mjs .prettierrc.json",
    "test": "node --test scripts/check-monorepo.test.mjs scripts/check-pilot-private-046.test.mjs scripts/check-pilot-preview-046.test.mjs && pnpm --filter @bluedotatlas/core test"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "typescript-eslint": "8.73.0",
    "prettier": "3.9.2",
    "playwright": "1.56.1"
  }
}
