{
  "name": "@bluedotatlas/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @bluedotatlas/core build && tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test:integration": "pnpm --filter @bluedotatlas/core build && tsx --test --test-concurrency=1 tests/db.integration.test.ts tests/project-model.integration.test.ts tests/admin-auth.integration.test.ts tests/project-dashboard.integration.test.ts tests/step-progress.integration.test.ts",
    "test:queue": "pnpm --filter @bluedotatlas/core build && tsx --test --test-concurrency=1 tests/worker-queue.integration.test.ts",
    "test:render-046": "pnpm --filter @bluedotatlas/core build && tsx --test --test-concurrency=1 ../../apps/worker/tests/render-046.integration.test.ts"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js",
    "./auth": "./dist/auth-service.js",
    "./api": "./dist/api-service.js",
    "./queue": "./dist/queue.js",
    "./queue-046": "./dist/queue-046.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3",
    "@bluedotatlas/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0"
  }
}
