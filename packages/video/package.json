{
  "name": "@bluedotatlas/video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render:proof": "remotion render src/entry.tsx BDA038TenSecondProof out/038-proof.mp4 --codec=h264 --pixel-format=yuv420p --concurrency=1 --disallow-parallel-encoding",
    "studio": "remotion studio src/entry.tsx",
    "render:footage-proof": "remotion render src/entry.tsx BDA039FootageProof out/039-footage-proof.mp4 --codec=h264 --pixel-format=yuv420p --concurrency=1 --disallow-parallel-encoding --offthreadvideo-video-threads=1",
    "render:graphics-proof": "remotion render src/entry.tsx BDA040GraphicsProof out/040-graphics-proof.mp4 --codec=h264 --pixel-format=yuv420p --concurrency=1 --disallow-parallel-encoding"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@remotion/media": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.545",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
